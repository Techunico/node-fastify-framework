{
  "$comment": "Single source of truth for generated applications: npm packages, database bindings and optional plugins. Read by the plugin registry (src/plugins/index.ts) and by the CLI (packages/create-techunico-app). Versions must match the framework's root package.json (enforced by tests).",
  "node": ">=20.0.0",
  "core": {
    "dependencies": {
      "bcrypt": "^6.0.0",
      "dotenv": "^17.4.2",
      "fastify": "^5.8.5",
      "fastify-plugin": "^5.1.0",
      "jsonwebtoken": "^9.0.3",
      "pino-pretty": "^13.1.3",
      "prom-client": "^15.1.3",
      "tsconfig-paths": "^4.2.0",
      "zod": "^4.3.6"
    },
    "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^25.6.0",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "typescript": "^6.0.2"
    }
  },
  "databases": {
    "postgresql": {
      "label": "PostgreSQL (Prisma)",
      "dependencies": {
        "@prisma/adapter-pg": "^7.7.0",
        "@prisma/client": "^7.7.0",
        "pg": "^8.20.0"
      },
      "devDependencies": {
        "@types/pg": "^8.20.0",
        "prisma": "^7.7.0"
      },
      "files": ["prisma", "prisma.config.ts", "src/generated", "src/plugins/db-prisma"]
    },
    "mongodb": {
      "label": "MongoDB (Mongoose)",
      "dependencies": {
        "mongoose": "^8.24.2"
      },
      "devDependencies": {},
      "files": ["src/plugins/db-mongoose", "src/models", "scripts/seed.ts"]
    }
  },
  "plugins": {
    "redis": {
      "label": "Redis",
      "description": "Shared ioredis connection (app.redis)",
      "stability": "stable",
      "entry": "redis/redis.plugin",
      "requires": [],
      "optional": [],
      "dependencies": { "ioredis": "^5.10.1" },
      "files": ["src/plugins/redis"]
    },
    "cache": {
      "label": "Cache",
      "description": "JSON cache on Redis (app.cache)",
      "stability": "stable",
      "entry": "cache/cache.plugin",
      "requires": ["redis"],
      "optional": [],
      "dependencies": {},
      "files": ["src/plugins/cache"]
    },
    "queue": {
      "label": "Queue (BullMQ)",
      "description": "BullMQ queues on Redis (app.queue)",
      "stability": "stable",
      "entry": "queue/queue.plugin",
      "requires": ["redis"],
      "optional": [],
      "dependencies": { "bullmq": "^5.74.1" },
      "files": ["src/plugins/queue", "src/queues"]
    },
    "events": {
      "label": "Events",
      "description": "Domain events, sync or queued (app.event)",
      "stability": "stable",
      "entry": "events/events.plugin",
      "requires": ["queue"],
      "optional": [],
      "dependencies": {},
      "files": ["src/plugins/events", "src/events"]
    },
    "geo": {
      "label": "Geo / maps",
      "description": "Geocoding, routing and places via Google (app.geo)",
      "stability": "stable",
      "entry": "geo/plugin",
      "requires": [],
      "optional": ["cache"],
      "dependencies": { "axios": "^1.19.0", "geolib": "^3.3.14" },
      "files": ["src/plugins/geo"]
    },
    "cloudinary": {
      "label": "Cloudinary",
      "description": "Media uploads and transformations (app.cloudinary)",
      "stability": "stable",
      "entry": "cloudinary/cloudinary.plugin",
      "requires": [],
      "optional": [],
      "dependencies": { "cloudinary": "^2.10.0" },
      "files": ["src/plugins/cloudinary"]
    },
    "payment": {
      "label": "Payments (Razorpay)",
      "description": "Payment gateway abstraction (app.payment)",
      "stability": "stable",
      "entry": "payment/plugin",
      "requires": [],
      "optional": [],
      "dependencies": { "razorpay": "^2.9.8" },
      "files": ["src/plugins/payment"]
    }
  }
}
