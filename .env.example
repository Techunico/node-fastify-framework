# ========================
# 🚀 App Configuration
# ========================

PORT=3000
NODE_ENV=development

API_PREFIX=/api
API_VERSION=v1

# ========================
# 🧠 Database (set by CLI)
# ========================

DB_PROVIDER=

# PostgreSQL (Prisma)
DATABASE_URL=

# MongoDB (Mongoose)
MONGO_URI=

# ========================
# 🔐 Authentication
# ========================

JWT_SECRET=SUPERSECURESECRET

# ========================
# 🔌 Plugins (comma separated)
# ========================

PLUGINS=

# ========================
# 🔴 Redis (optional)
# ========================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# 📦 Queue / Jobs (optional)
# ========================

QUEUE_PREFIX=techunico

# ========================
# 📡 Metrics (optional)
# ========================

METRICS_ENABLED=true

# ========================
# 🗺️ Geo plugin (PLUGINS=geo)
# ========================

GEO_PROVIDER=google
# GEO_FALLBACK_PROVIDER=tomtom
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BASE_URL=
# GOOGLE_ROUTES_BASE_URL=
# GOOGLE_PLACES_BASE_URL=
# GOOGLE_ROADS_BASE_URL=
# TOMTOM_API_KEY=
# GEO_REQUEST_TIMEOUT_MS=5000
# GEO_REQUEST_RETRIES=2

# ========================
# 🖼️ Cloudinary (PLUGINS=cloudinary)
# ========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DEFAULT_FOLDER=general
CLOUDINARY_SECURE=true

# ========================
# 💳 Payments (PLUGINS=payment)
# ========================

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# PAYMENT_MOCK_STABLE_IDS=false