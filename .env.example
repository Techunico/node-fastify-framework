# ========================
# 🚀 App Configuration
# ========================

PORT=3000
NODE_ENV=development
# LOG_LEVEL=info

API_PREFIX=/api
API_VERSION=v1

# ========================
# 🧠 Database (set by CLI)
# ========================

DB_PROVIDER=

# PostgreSQL (Prisma)
DATABASE_URL=

# MongoDB (Mongoose)
MONGO_URI=

# ========================
# 🔐 Authentication
# ========================
# Required. Random value of at least 32 characters; placeholders are rejected.
# The CLI writes unique values into .env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional. Separate key for admin tokens (userType "admin"). Must differ from JWT_SECRET.
JWT_ADMIN_SECRET=
# JWT_ISSUER=techunico
# JWT_AUDIENCE=techunico-api
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ========================
# 🔌 Plugins (comma separated)
# ========================

PLUGINS=

# ========================
# 🔴 Redis (PLUGINS=redis)
# ========================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# 🗺️ Geo plugin (PLUGINS=geo)
# ========================

GEO_PROVIDER=google
# GEO_FALLBACK_PROVIDER=tomtom
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BASE_URL=
# GOOGLE_ROUTES_BASE_URL=
# GOOGLE_PLACES_BASE_URL=
# GOOGLE_ROADS_BASE_URL=
# TOMTOM_API_KEY=
# GEO_REQUEST_TIMEOUT_MS=5000
# GEO_REQUEST_RETRIES=2

# ========================
# 🖼️ Cloudinary (PLUGINS=cloudinary)
# ========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DEFAULT_FOLDER=general
CLOUDINARY_SECURE=true

# ========================
# 💳 Payments (PLUGINS=payment)
# ========================
# In production the plugin refuses to start without valid Razorpay keys and
# never uses the mock gateway. Outside production, missing keys fall back to
# the mock gateway with a warning.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# PAYMENT_MOCK_STABLE_IDS=false
